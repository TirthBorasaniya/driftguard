# Data — tracked separately (too large for git, may contain dataset records)
data/raw/
data/processed/
data/features/
data/reference/
data/production_batches/

# Encoders — NOT committed. The .pkl files embed raw categorical vocabularies
# and are pickle blobs (deserialization risk). Regenerate locally / ship via
# a release asset or object store for deployment.
data/encoders/*.pkl

# Model artifact — committed for deployment (see render.yaml)
# models/          <- intentionally NOT ignored

# ONNX export — regenerated from the MLflow champion via
# src/serving/onnx_export.py, not committed (per explicit instruction; this
# is an exception to the models/ policy above, which does commit the other
# model artifacts in this same directory)
models/champion.onnx

# MLflow
mlruns/
mlflow.db

# Feast registry (auto-generated by feast apply)
data/feast_registry.db
src/features/feature_repo/data/

# Shadow-mode prediction log — SHADOW_LOG_PATH in src/config.py writes live
# champion/challenger prediction pairs here at serving time. Runtime output,
# never for git.
models/shadow_predictions.csv

# Predictions database (runtime state, not for git)
predictions.db
predictions.db-shm
predictions.db-wal
*.db
*.sqlite
*.sqlite3

# Evidently reports (regenerated on demand)
reports/*.html

# Secrets and credentials — never commit
.env
.env.*
!.env.example
credentials.json
service-account*.json
id_rsa
id_rsa.pub
*.pem
*.key
*.pfx
*.p12
.npmrc
.pypirc
.netrc

# Model weights and checkpoints — regenerate or fetch, do not commit
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.h5
*.onnx

