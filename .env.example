# Real-Time Network Anomaly Detection Pipeline — Environment Configuration
# Copy to .env and fill in values before running.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=network_flows
KAFKA_DLQ_TOPIC=network_flows.dlq
KAFKA_GROUP_ID=network-flow-consumer

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_EXPERIMENT_NAME=network_anomaly_detection
MLFLOW_MODEL_NAME=network-anomaly-detector

# Model
# scale_pos_weight is computed dynamically from the real training label
# distribution at training time (see train.compute_scale_pos_weight), not
# set here
# challenger must exceed champion PR-AUC by this margin to be promoted
CHAMPION_IMPROVEMENT_THRESHOLD=0.005

# Drift detection
DRIFT_MIN_WINDOW=500
DRIFT_SHARE_THRESHOLD=0.3

# Self-healing: AUTO | SHADOW | ALERT_ONLY
HEALING_MODE=AUTO
HEALING_COOLDOWN_HOURS=6

# API
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Grafana (used by docker compose only)
# REQUIRED: docker compose refuses to start if this is unset or empty.
# Set a strong, unique value in your real .env (never commit it).
GF_ADMIN_PASSWORD=
