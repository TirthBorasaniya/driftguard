# DriftGuard environment. Copy to .env and fill in the placeholders. Never commit .env.

# Service wiring (Docker Compose overrides these with in-network hostnames)
DATASET=cicids2017
LOG_LEVEL=INFO
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000
PREFECT_API_URL=http://localhost:4200/api
SERVING_URL=http://localhost:8001
PROMETHEUS_URL=http://localhost:9090

# Secrets (required)
# Token for POST /admin/rollout and POST /admin/rollback
ADMIN_TOKEN=change-me
# Salt for hashing source and destination IPs into stream-feature keys
IP_HASH_SALT=change-me
# Grafana admin password (Docker Compose refuses to start without it)
GF_ADMIN_PASSWORD=change-me

# Optional overrides
# DRIFTGUARD_HARDWARE="Apple M2, 16 GB"
