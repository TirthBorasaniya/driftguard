# DriftGuard environment. Copy to .env and fill in the placeholders. Never commit .env.

# Service wiring (Docker Compose overrides these with in-network hostnames)
DATASET=cicids2017
LOG_LEVEL=INFO
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000
PREFECT_API_URL=http://localhost:4200/api
SERVING_URL=http://localhost:8001
PROMETHEUS_URL=http://localhost:9090

# Secrets (required). Leave empty and run `make env`: it generates strong values. Empty,
# placeholder, and short (under 16 characters) values are rejected at startup.
# Token for POST /admin/rollout and POST /admin/rollback
ADMIN_TOKEN=
# Salt for hashing source and destination IPs into stream-feature keys
IP_HASH_SALT=
# Grafana admin password (Docker Compose refuses to start without it)
GF_ADMIN_PASSWORD=

# Optional overrides
# DRIFTGUARD_HARDWARE="Apple M2, 16 GB"
# Load tests only: "off" replaces stream features with zeros to measure their cost
# STREAM_FEATURES_MODE=on
# Paths and identity (defaults are repository-relative or derived from the pod name)
# CONFIG_DIR=configs
# DATA_DIR=data
# RESULTS_DIR=results
# OFFLINE_DIR=data/offline
# FEAST_REPO_PATH=src/driftguard/features/feature_repo
# ORCHESTRATOR_DB_PATH=data/orchestrator.db
# PROMOTIONS_LOG_PATH=results/promotions.jsonl
# METRICS_PORT=9101
# INSTANCE_ID=
